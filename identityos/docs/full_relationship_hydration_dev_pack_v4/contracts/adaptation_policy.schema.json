{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://identityos.dev/schemas/adaptation_policy.schema.json",
  "title": "AdaptationPolicy",
  "type": "object",
  "required": ["policy_id", "version", "persona_id", "rules", "prohibitions", "provenance_refs"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "persona_id": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["context", "behavior"],
        "properties": {
          "context": {"type": "string", "minLength": 1},
          "behavior": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "prohibitions": {"type": "array", "items": {"type": "string"}},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
