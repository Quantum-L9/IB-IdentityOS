{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://identityos.dev/schemas/domain_lens.schema.json",
  "title": "DomainLens",
  "type": "object",
  "required": ["lens_id", "version", "name", "purpose", "applicability", "provenance_refs"],
  "properties": {
    "lens_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "applicability": {"type": "object", "additionalProperties": true},
    "bounded_outputs": {"type": "array", "items": {"type": "string"}},
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
