{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://identityos.dev/schemas/persona.schema.json",
  "title": "PersonaDefinition",
  "type": "object",
  "required": [
    "persona_id",
    "identity_ref",
    "version",
    "persona_origin",
    "eval_suite_refs"
  ],
  "properties": {
    "persona_id": {
      "type": "string",
      "minLength": 1
    },
    "identity_ref": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "presentation": {
      "type": "object",
      "additionalProperties": true
    },
    "behavior": {
      "type": "object",
      "properties": {
        "obligations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interaction_style": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory_policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trust_requirements": {
      "type": "object",
      "additionalProperties": true
    },
    "compatible_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eval_suite_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "persona_origin": {
      "enum": [
        "NATIVE",
        "DERIVED",
        "SYNTHETIC"
      ]
    },
    "principle_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "cognitive_profile_ref": {
      "type": "string"
    },
    "decision_lens_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domain_lens_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presentation_profile_ref": {
      "type": "string"
    },
    "interaction_profile_ref": {
      "type": "string"
    },
    "adaptation_policy_ref": {
      "type": "string"
    },
    "derivation_ref": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
