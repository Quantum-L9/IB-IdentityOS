{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://identityos.dev/schemas/consent_grant.schema.json",
  "title": "Consent Grant",
  "type": "object",
  "required": [
    "consent_id",
    "grantor_actor_ref",
    "actions",
    "status"
  ],
  "properties": {
    "consent_id": {
      "type": "string",
      "minLength": 1
    },
    "grantor_actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "grantee_actor_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "STORE",
          "HYDRATE",
          "DISCLOSE",
          "SHARE_WITH_ACTOR",
          "PROMOTE_TO_DURABLE"
        ]
      }
    },
    "context_scope_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
