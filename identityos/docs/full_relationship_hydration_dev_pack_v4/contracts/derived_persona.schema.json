{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://identityos.dev/schemas/derived_persona.schema.json",
  "title": "DerivedPersona",
  "type": "object",
  "required": [
    "persona_id",
    "identity_ref",
    "version",
    "persona_origin",
    "provenance",
    "eval_suite_refs"
  ],
  "properties": {
    "persona_id": {
      "type": "string",
      "minLength": 1
    },
    "identity_ref": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "persona_origin": {
      "const": "DERIVED"
    },
    "principle_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "cognitive_profile_ref": {
      "type": "string"
    },
    "decision_lens_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domain_lens_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presentation_profile_ref": {
      "type": "string"
    },
    "interaction_profile_ref": {
      "type": "string"
    },
    "adaptation_policy_ref": {
      "type": "string"
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatible_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "persona_provenance.schema.json"
    },
    "eval_suite_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_identity_equivalence": {
      "const": false
    },
    "source_endorsement_claimed": {
      "const": false
    }
  },
  "additionalProperties": false
}
