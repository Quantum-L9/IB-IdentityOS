{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://identityos.dev/schemas/decision_lens.schema.json",
  "title": "DecisionLens",
  "type": "object",
  "required": [
    "lens_id",
    "version",
    "name",
    "steps",
    "applicability",
    "provenance_refs"
  ],
  "properties": {
    "lens_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "conflict_policy": {
      "type": "string"
    },
    "eval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
