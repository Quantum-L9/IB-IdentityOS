{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://identityos.dev/schemas/brand_profile.schema.json",
  "title": "IdentityOS BrandProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@id",
    "@type",
    "brand_id",
    "version",
    "presentation",
    "behavior",
    "authority",
    "truth_bindings"
  ],
  "properties": {
    "@id": {
      "type": "string",
      "minLength": 1
    },
    "@type": {
      "const": "BrandProfile"
    },
    "brand_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice",
        "tone"
      ],
      "properties": {
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_identity_ref": {
          "type": "string"
        },
        "avatar_ref": {
          "type": "string"
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "interaction_rules",
        "prohibited_behaviors"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customer_promise": {
          "type": "string"
        },
        "interaction_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited_behaviors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_actions",
        "escalation_policy_ref"
      ],
      "properties": {
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "escalation_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "claim_policy_ref": {
          "type": "string"
        },
        "compliance_policy_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "truth_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "authority_ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "product",
              "catalog",
              "pricing",
              "offer",
              "policy",
              "crm",
              "billing",
              "order",
              "claims",
              "other"
            ]
          },
          "authority_ref": {
            "type": "string",
            "minLength": 1
          },
          "allowed_scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "freshness_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "required_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "memory_policy_ref": {
      "type": "string"
    },
    "channel_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
